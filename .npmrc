## pnpm configuration for Rubic monorepo

# Auto-install peers (pnpm 8+ default, explicit for clarity)
auto-install-peers=true

# Fail on unmet peer dependencies during install
strict-peer-dependencies=true

# Prefer offline — use cache first, then network
prefer-offline=true

# Dedupe peer dependencies to avoid multiple React instances
dedupe-peer-dependents=true

# Hoist server-only packages to root so Turbopack can resolve them
# from transpiled workspace packages (pnpm strict hoisting + Next.js)
public-hoist-pattern[]=better-auth
public-hoist-pattern[]=drizzle-orm
public-hoist-pattern[]=@neondatabase/serverless
