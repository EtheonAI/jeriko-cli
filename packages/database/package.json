{
  "name": "@repo/database",
  "version": "0.0.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./service": {
      "types": "./src/service-client.ts",
      "default": "./src/service-client.ts"
    },
    "./service-index": {
      "types": "./src/service-index.ts",
      "default": "./src/service-index.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "build": "echo 'No build step needed for Drizzle'",
    "clean": "git clean -xdf .cache .turbo dist node_modules drizzle",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "6.18.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "drizzle-orm": "^0.38.3",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.9.1",
    "drizzle-kit": "^0.30.1",
    "prisma": "6.18.0",
    "typescript": "^5.9.3"
  }
}
