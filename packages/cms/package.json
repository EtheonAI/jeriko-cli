{
  "name": "@repo/cms",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./access": {
      "types": "./access.ts",
      "default": "./access.ts"
    },
    "./collections": {
      "types": "./collections/index.ts",
      "default": "./collections/index.ts"
    },
    "./content": {
      "types": "./content.ts",
      "default": "./content.ts"
    },
    "./globals": {
      "types": "./globals/index.ts",
      "default": "./globals/index.ts"
    },
    "./keys": {
      "types": "./keys.ts",
      "default": "./keys.ts"
    },
    "./next-config": {
      "types": "./next-config.ts",
