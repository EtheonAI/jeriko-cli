    "payload": "3.85.0",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.9.1",
    "esbuild": "0.28.0",
    "next": "16.2.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
