{
  "name": "@repo/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agents": {
      "types": "./src/agents/index.ts",
      "default": "./src/agents/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./messages": {
      "types": "./src/messages/index.ts",
      "default": "./src/messages/index.ts"
    },
    "./media": {
      "types": "./src/media/index.ts",
      "default": "./src/media/index.ts"
    },
    "./models": {
      "types": "./src/models/index.ts",
      "default": "./src/models/index.ts"
    },
    "./observability": {
      "types": "./src/observability/index.ts",
      "default": "./src/observability/index.ts"
    },
    "./retrieval": {
      "types": "./src/retrieval/index.ts",
      "default": "./src/retrieval/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./tools": {
      "types": "./src/tools/index.ts",
      "default": "./src/tools/index.ts"
    },
    "./tools/*": {
      "types": "./src/tools/*.ts",
      "default": "./src/tools/*.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@repo/connectors": "workspace:*",
    "ai": "6.0.193",
    "server-only": "^0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
