{
  "name": "@repo/design-system",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./index.tsx",
      "default": "./index.tsx"
    },
    "./components/ui/*": {
      "types": "./components/ui/*.tsx",
      "default": "./components/ui/*.tsx"
    },
    "./components/mode-toggle": {
      "types": "./components/mode-toggle.tsx",
      "default": "./components/mode-toggle.tsx"
    },
    "./components/actions": {
      "types": "./components/actions/index.ts",
      "default": "./components/actions/index.ts"
    },
    "./components/data-display": {
      "types": "./components/data-display/index.ts",
      "default": "./components/data-display/index.ts"
    },
    "./components/feedback": {
      "types": "./components/feedback/index.ts",
      "default": "./components/feedback/index.ts"
    },
    "./components/forms": {
      "types": "./components/forms/index.ts",
      "default": "./components/forms/index.ts"
    },
    "./components/layout": {
      "types": "./components/layout/index.ts",
      "default": "./components/layout/index.ts"
    },
    "./components/navigation": {
      "types": "./components/navigation/index.ts",
      "default": "./components/navigation/index.ts"
    },
    "./components/overlays": {
      "types": "./components/overlays/index.ts",
      "default": "./components/overlays/index.ts"
    },
    "./lib/*": {
      "types": "./lib/*.ts",
      "default": "./lib/*.ts"
    },
    "./providers/*": {
      "types": "./providers/*.tsx",
      "default": "./providers/*.tsx"
    },
    "./hooks/*": {
      "types": "./hooks/*.ts",
      "default": "./hooks/*.ts"
    },
    "./styles/*": "./styles/*",
    "./postcss.config.mjs": "./postcss.config.mjs"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.76.1",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.15",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
