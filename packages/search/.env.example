# Typesense Configuration

# Host where Typesense server is running
TYPESENSE_HOST=localhost

# Port for Typesense server (default: 8108)
TYPESENSE_PORT=8108

# Protocol (http for local development, https for production)
TYPESENSE_PROTOCOL=http

# API key for Typesense (admin key for server-side operations)
# For local development, use the key set in docker-compose.typesense.yml
TYPESENSE_API_KEY=rubic-local-dev-key
