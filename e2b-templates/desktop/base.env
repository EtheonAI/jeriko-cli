# Rubic Sandbox — Base Environment (Layer 1)
export HOME=/home/ubuntu
export USER=ubuntu
export LANG=en_US.UTF-8
export DISPLAY=:0
export RUBIC_OPT_PATH=/opt/.rubic
export RUNTIME_PATH=/opt/.rubic/runtime
export PYTHONPATH=/opt/.rubic/runtime
export PYTHONIOENCODING=utf-8
export CHROME_INSTANCE_PATH=/usr/bin/chromium-browser
export WEBDEV_TEMPLATES_PATH=/opt/.rubic/webdev/templates
export TZ=UTC
export SANDBOX_SERVER_PORT=8330
export SANDBOX_INTERNAL_PORT=9330
export NEKO_PORT=8333
export NVM_DIR="$HOME/.nvm"
export PNPM_HOME="$HOME/.local/share/pnpm"
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
export PATH="$HOME/bin:$HOME/.local/bin:$PNPM_HOME:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
