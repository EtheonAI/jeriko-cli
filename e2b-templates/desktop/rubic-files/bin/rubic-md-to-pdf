#!/bin/bash
# rubic-md-to-pdf — Convert Markdown to PDF, DOCX, or HTML
# Usage: rubic-md-to-pdf input.md [-o output] [--format pdf|docx|html]
set -euo pipefail

INPUT=""
OUTPUT=""
FORMAT="pdf"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--output) OUTPUT="$2"; shift 2 ;;
    --format)    FORMAT="$2"; shift 2 ;;
    -h|--help)
      echo "Usage: rubic-md-to-pdf input.md [-o output] [--format pdf|docx|html]"
      echo "  Converts Markdown to the specified format using pandoc."
      echo "  Defaults to PDF output."
      exit 0
      ;;
    *) INPUT="$1"; shift ;;
  esac
done

if [ -z "$INPUT" ]; then
  echo "Error: No input file specified." >&2
  echo "Usage: rubic-md-to-pdf input.md [-o output] [--format pdf|docx|html]" >&2
  exit 1
fi

if [ ! -f "$INPUT" ]; then
  echo "Error: Input file '$INPUT' not found." >&2
  exit 1
fi

BASENAME="${INPUT%.*}"
if [ -z "$OUTPUT" ]; then
  OUTPUT="${BASENAME}.${FORMAT}"
fi

case "$FORMAT" in
  pdf)
    pandoc "$INPUT" -o "$OUTPUT" --pdf-engine=wkhtmltopdf \
      -V margin-top=20mm -V margin-bottom=20mm \
      -V margin-left=25mm -V margin-right=25mm \
      --highlight-style=tango
    ;;
  docx)
    pandoc "$INPUT" -o "$OUTPUT" --highlight-style=tango
    ;;
  html)
    pandoc "$INPUT" -o "$OUTPUT" --standalone --highlight-style=tango \
      --metadata title="$(basename "$BASENAME")"
    ;;
  *)
    echo "Error: Unsupported format '$FORMAT'. Use pdf, docx, or html." >&2
    exit 1
    ;;
esac

echo "$OUTPUT"
