#!/bin/bash
# rubic-export-slides — Convert Markdown to PPTX slides
# Usage: rubic-export-slides input.md [-o output.pptx]
set -euo pipefail

INPUT=""
OUTPUT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--output) OUTPUT="$2"; shift 2 ;;
    -h|--help)
      echo "Usage: rubic-export-slides input.md [-o output.pptx]"
      echo "  Converts Markdown with '---' slide separators to PPTX."
      exit 0
      ;;
    *) INPUT="$1"; shift ;;
  esac
done

if [ -z "$INPUT" ]; then
  echo "Error: No input file specified." >&2
  echo "Usage: rubic-export-slides input.md [-o output.pptx]" >&2
  exit 1
fi

if [ ! -f "$INPUT" ]; then
  echo "Error: Input file '$INPUT' not found." >&2
  exit 1
fi

BASENAME="${INPUT%.*}"
if [ -z "$OUTPUT" ]; then
  OUTPUT="${BASENAME}.pptx"
fi

python3 -c "
import sys
from pptx import Presentation
from pptx.util import Inches, Pt

input_path = sys.argv[1]
output_path = sys.argv[2]

with open(input_path, 'r') as f:
    content = f.read()

# Split on horizontal rules (--- or ***)
slides_raw = [s.strip() for s in content.split('---') if s.strip()]

prs = Presentation()
prs.slide_width = Inches(13.333)
prs.slide_height = Inches(7.5)

for slide_text in slides_raw:
    lines = slide_text.split('\n')
    title = ''
    body_lines = []
    for line in lines:
        stripped = line.strip()
        if stripped.startswith('#') and not title:
            title = stripped.lstrip('#').strip()
        else:
            body_lines.append(line)

    body = '\n'.join(body_lines).strip()
    slide_layout = prs.slide_layouts[1]  # Title + Content
    slide = prs.slides.add_slide(slide_layout)

    if title and slide.shapes.title:
        slide.shapes.title.text = title
    if body and len(slide.placeholders) > 1:
        slide.placeholders[1].text = body

prs.save(output_path)
print(output_path)
" "$INPUT" "$OUTPUT"
