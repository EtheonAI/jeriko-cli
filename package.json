{
  "name": "rubic",
  "version": "5.2.1",
  "bin": {
    "next-forge": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:services": "turbo dev:services --filter='./services/*' --concurrency=15",
    "services:up": "docker compose -f docker-compose.services.yml up -d postgres redis",
    "services:down": "docker compose -f docker-compose.services.yml down",
    "services:logs": "docker compose -f docker-compose.services.yml logs -f",
    "check": "npx ultracite@latest check",
    "fix": "npx ultracite@latest fix",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:security": "turbo test:security",
    "test:contract": "turbo test:contract",
    "test:coverage": "turbo test:coverage",
    "test:a11y": "pnpm --filter app test:e2e -- --project=chromium e2e/accessibility/",
    "test:visual": "pnpm --filter app test:e2e -- --project=visual-regression",
    "test:smoke": "pnpm --filter app test:e2e -- --project=chromium e2e/features/smoke.spec.ts",
    "test:agent": "cd services/agent && python -m pytest tests/ -v",
    "test:all": "turbo test test:integration && pnpm test:agent",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "boundaries:cruise": "depcruise --config .dependency-cruiser.cjs apps packages services",
    "lhci": "lhci autorun",
    "bump-deps": "npx npm-check-updates --deep -u -x recharts && pnpm install",
    "bump-ui": "npx shadcn@latest add --all --overwrite -c packages/design-system",
    "migrate": "cd packages/database && pnpm db:push",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "clean": "git clean -xdf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@auto-it/first-time-contributor": "^11.3.0",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.1.6",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.8.3",
    "@types/node": "^24.9.1",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^9.39.1",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.2",
    "prettier": "^3.4.2",
    "tsup": "^8.5.0",
    "turbo": "^2.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "commander": "^14.0.2",
    "nanoid": "^5.1.6"
  },
  "pnpm": {
    "overrides": {
      "parse5": "^7.2.1",
      "@types/react": "19.2.13",
      "@types/react-dom": "19.2.3",
      "ai": "6.0.77",
      "drizzle-orm": "0.38.4",
      "zod": "4.3.6"
    },
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "*"
        }
      }
    }
  },
  "type": "module"
}
