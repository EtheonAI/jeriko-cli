{
  "name": "jeriko",
  "version": "5.2.1",
  "bin": {
    "next-forge": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "turbo build --filter=app --filter=web",
    "build:product": "turbo build --filter=app --filter=web",
    "build:docs": "pnpm --filter docs lint",
    "build:email": "turbo build --filter=email",
    "build:storybook": "turbo build --filter=storybook",
    "build:all": "turbo build",
    "dev": "turbo dev --filter=app",
    "dev:web": "turbo dev --filter=web",
    "dev:docs": "turbo dev --filter=docs",
    "dev:email": "turbo dev --filter=email",
    "dev:storybook": "turbo dev --filter=storybook",
    "dev:studio": "turbo dev --filter=studio",
    "dev:frontend": "turbo dev --filter=app --filter=web",
    "dev:all": "turbo dev",
    "infra:up": "docker compose -f docker-compose.infra.yml up -d postgres redis typesense",
    "infra:down": "docker compose -f docker-compose.infra.yml down",
    "infra:logs": "docker compose -f docker-compose.infra.yml logs -f postgres redis typesense",
    "lint": "eslint .",
    "lint:docs": "pnpm --filter docs lint",
    "typecheck": "turbo typecheck",
    "check": "npx ultracite@latest check",
    "fix": "npx ultracite@latest fix",
    "test": "vitest run",
    "test:integration": "turbo test:integration",
    "test:security": "turbo test:security",
    "test:contract": "turbo test:contract",
    "test:coverage": "turbo test:coverage",
    "test:a11y": "echo \"apps/app e2e tests are intentionally removed during reset\"",
    "test:visual": "echo \"apps/app visual tests are intentionally removed during reset\"",
    "test:smoke": "vitest run --project app",
    "test:all": "turbo test",
    "test:all:integration": "turbo test test:integration",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "boundaries:cruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "lhci": "lhci autorun",
    "bump-deps": "npx npm-check-updates --deep -u -x recharts && pnpm install",
    "bump-ui": "npx shadcn@latest add --all --overwrite -c packages/design-system",
    "migrate": "cd packages/database && pnpm db:push",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "clean": "git clean -xdf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.2.6",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.9.16",
    "@types/node": "^25.9.1",
    "dependency-cruiser": "^17.4.2",
    "esbuild": "0.28.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=11.4.0 <12"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "commander": "^15.0.0",
    "nanoid": "^5.1.11"
  },
  "type": "module"
}
