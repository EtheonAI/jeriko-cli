{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "envMode": "loose",
  "cacheDir": ".turbo/cache",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "**/generated/**",
        "storybook-static/**",
        "dist/**"
      ]
    },
    "@repo/cms#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@repo/database#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@repo/search#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DATABASE_URL", "REDIS_URL"]
    },
    "test:security": {
      "dependsOn": ["^build"]
    },
    "test:contract": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:a11y": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:visual": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:load": {
      "cache": false
    },
    "analyze": {
      "dependsOn": ["^analyze"]
    },
    "boundaries": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "translate": {
      "dependsOn": ["^translate"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  }
}
