# Dependencies (re-installed inside Docker)
**/node_modules
**/.pnpm-store

# Build outputs (rebuilt inside Docker)
**/dist
**/.next
**/storybook-static
**/.react-email

# Caches
**/.turbo
**/.cache
**/coverage
**/__pycache__
**/*.pyc

# Git & IDE
.git
.github
.claude
.cursor
.agents
.changeset
.husky

# Documentation
docs/
*.md
!pnpm-workspace.yaml

# OS
.DS_Store
Thumbs.db

# Env files (secrets — never bake into images)
.env
.env.*
!.env.example
**/services/*/.env
**/services/*/.env.*

# Tests & dev tooling
**/*.test.ts
**/*.spec.ts
**/*.test.tsx
**/*.spec.tsx
**/e2e/
**/playwright-report/
**/vitest.config.*
**/playwright.config.*
**/__tests__/
