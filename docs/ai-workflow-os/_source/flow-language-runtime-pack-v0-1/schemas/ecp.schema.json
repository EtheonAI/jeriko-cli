{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuest.ai/schemas/ecp.schema.json",
  "title": "EventContextPacket v0.1",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema_version",
    "org_id",
    "workflow_id",
    "run_id",
    "summary",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "org_id": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string"
    },
    "workflow_version_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "worker_id": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "app",
            "workflow",
            "subagent",
            "system",
            "user"
          ]
        },
        "provider": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "quality": {
      "type": "object"
    },
    "routing": {
      "type": "object"
    },
    "cost": {
      "type": "object"
    },
    "security": {
      "type": "object"
    }
  }
}
