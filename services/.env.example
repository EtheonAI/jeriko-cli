# Rubic Backend Services - Environment Variables

# ===========================================
# Common Settings
# ===========================================
NODE_ENV=development
JWT_SECRET=your-jwt-secret-change-in-production

# ===========================================
# Database (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://rubic:rubic_dev_password@localhost:5432/rubic

# ===========================================
# Redis
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# LLM Providers
# ===========================================
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# ===========================================
# AWS Services
# ===========================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=rubic-files-dev
AWS_IOT_ENDPOINT=your-iot-endpoint.iot.us-east-1.amazonaws.com

# ===========================================
# Third-Party Services
# ===========================================

# E2B (Code Sandbox)
E2B_API_KEY=your-e2b-api-key

# Composio (Tool Integrations)
COMPOSIO_API_KEY=your-composio-api-key
COMPOSIO_BASE_URL=

# Inngest (Workflow Orchestration)
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Knock (Notifications)
KNOCK_API_KEY=your-knock-api-key

# Svix (Webhooks)
SVIX_API_KEY=your-svix-api-key

# Resend (Email)
RESEND_API_KEY=your-resend-api-key

# AgentMail (Agent Email Inboxes)
AGENTMAIL_API_KEY=your-agentmail-api-key
AGENTMAIL_WEBHOOK_SECRET=your-agentmail-webhook-secret

# Stripe (Billing)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Serper/Tavily (Search)
SERPER_API_KEY=your-serper-api-key
TAVILY_API_KEY=your-tavily-api-key

# ===========================================
# Website Builder
# ===========================================

# TiDB Cloud (Database per website)
TIDB_PUBLIC_KEY=your-tidb-public-key
TIDB_PRIVATE_KEY=your-tidb-private-key

# Vercel (Deployment)
VERCEL_TOKEN=your-vercel-token

# ===========================================
# Service Ports (for local development)
# ===========================================
GATEWAY_PORT=3001
TASK_PORT=3002
FILE_PORT=3003
WEBSITE_PORT=3004
BILLING_PORT=3005
NOTIFICATION_PORT=3006
WEBHOOK_PORT=3007
CONNECTOR_PORT=3008
SEARCH_PORT=3009
PROJECT_PORT=3010
AGENT_PORT=8000
KNOWLEDGE_PORT=8001
DEVICE_PORT=4001
SANDBOX_PORT=4012

# Agent → Sandbox Service URL
SANDBOX_SERVICE_URL=http://localhost:4012
